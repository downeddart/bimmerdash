# Copy to .env and fill in. .env is git-ignored.

# BMW portal → CarData → "Technical access to BMW CarData" → Client ID
BIMMERDASH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Your car's VIN (optional: if empty, all cars on the account are recorded)
BIMMERDASH_VIN=

# Database password. Generate one with:  openssl rand -hex 24
# Letters and digits only: it is embedded in a connection URL.
BIMMERDASH_DB_PASSWORD=

# UK Fuel Finder API (optional, for fuel cost tracking). Register at
# https://www.gov.uk/guidance/access-the-latest-fuel-prices-and-forecourt-data-via-api-or-email
BIMMERDASH_FUEL_FINDER_CLIENT_ID=
BIMMERDASH_FUEL_FINDER_CLIENT_SECRET=

# Fuel grade and tank size can also be set on the web UI's Settings page, which wins.
# Fuel grade for prices: E10 (default for petrol), E5, B7_STANDARD (default for diesel),
# B7_PREMIUM. Petrol or diesel is read from your car's details.
# BIMMERDASH_FUEL_GRADE=E10

# Usable tank size in litres. Only needed if your car reports fuel as % but not litres.
# BIMMERDASH_TANK_LITRES=

# Web UI login. Leave on unless an SSO proxy in front already requires a login.
# BIMMERDASH_AUTH=on

# Port for the web UI (default 8320)
# BIMMERDASH_WEB_PORT=8320

# Image version to run (default: latest)
# BIMMERDASH_VERSION=latest

# Max CarData REST calls per 24 h (BMW's limit is 50)
# BIMMERDASH_API_DAILY_BUDGET=45

# How often to ask BMW's REST API for service dates, tyres, warnings and fuel use, in
# hours (1 call per car each time). 0 turns it off.
# BIMMERDASH_REST_POLL_HOURS=4

# Pushover, for alerts on your phone (optional; alerts always show on the Health page).
# Create an application at https://pushover.net/apps/build for the token.
# BIMMERDASH_PUSHOVER_TOKEN=
# BIMMERDASH_PUSHOVER_USER=
# Link added to each alert, e.g. http://192.168.1.10:8320 (optional)
# BIMMERDASH_PUBLIC_URL=

# Log level: DEBUG, INFO, WARNING
BIMMERDASH_LOG_LEVEL=INFO
