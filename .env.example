# Copy to .env and fill in. .env is git-ignored.

# BMW portal → CarData → "Technical access to BMW CarData" → Client ID
BIMMERDASH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Your car's VIN (optional: if empty, the collector subscribes to every car on the account)
BIMMERDASH_VIN=

# Log level: DEBUG, INFO, WARNING
BIMMERDASH_LOG_LEVEL=INFO
